spring.application.name=expense-service
server.port=8080

spring.datasource.url=jdbc:mysql://localhost:3306/expense_service?createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=CHANGE_ME

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Kafka CA cert is loaded from ca.pem in this folder (gitignored)
aiven.kafka.bootstrap-servers=your-service-name.aivencloud.com:PORT
aiven.kafka.username=avnadmin
aiven.kafka.password=CHANGE_ME

outbox.poller.batch-size=50

logging.file.name=logs/expense-service.log

# Public key only; the private key stays with user-group-service
jwt.public-key=file:${user.home}/splitwise-keys/public.pem
